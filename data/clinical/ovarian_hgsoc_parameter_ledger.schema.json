{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundation-0.dev/virtual-human/ovarian_hgsoc_parameter_ledger.schema.json",
  "title": "Ovarian HGSOC treatment-sequence parameter ledger",
  "description": "Machine-readable population parameters for research models. Extends the registry row shape used in Foundation-0/project-asma (sources registries, PR #47) with quantitative fields required by virtual-human treatment-sequence work.",
  "type": "object",
  "required": [
    "schema_version",
    "ledger_id",
    "checked_on",
    "scope",
    "extends",
    "entries"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "ledger_id": { "type": "string" },
    "checked_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "scope": { "type": "string" },
    "extends": {
      "type": "object",
      "required": ["description", "references"],
      "properties": {
        "description": { "type": "string" },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repository", "pull_request", "artifact"],
            "properties": {
              "repository": { "type": "string" },
              "pull_request": { "type": "integer" },
              "artifact": { "type": "string" }
            }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "quantity",
        "value",
        "range",
        "units",
        "population",
        "citation",
        "locator",
        "label",
        "limits"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][0-9]{3}$" },
        "quantity": { "type": "string", "minLength": 1 },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "type": "number" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "range": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["point", "CI95", "IQR", "min_max", "categorical"]
                },
                "low": { "type": ["number", "null"] },
                "high": { "type": ["number", "null"] },
                "level": { "type": ["number", "null"] },
                "categories": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          ]
        },
        "units": { "type": ["string", "null"] },
        "population": { "type": "string", "minLength": 1 },
        "citation": {
          "type": "object",
          "required": ["doi", "first_author_surname", "year", "title"],
          "properties": {
            "doi": { "type": "string", "minLength": 1 },
            "first_author_surname": { "type": "string", "minLength": 1 },
            "year": { "type": "integer" },
            "title": { "type": "string", "minLength": 1 }
          }
        },
        "locator": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "enum": ["KNOWN", "CONJECTURE", "MISSING"] },
        "derivation": { "type": ["string", "null"] },
        "limits": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "label": { "const": "MISSING" } } },
          "then": { "properties": { "value": { "type": "null" } } }
        }
      ]
    }
  }
}
